# Copy to .env and fill in. Never commit .env.

# ---- Supabase / Postgres connection (read-only role, analytics schema only) ----
CUBEJS_DB_TYPE=postgres
# Supabase -> Connect -> Session pooler, e.g. aws-1-us-east-2.pooler.supabase.com
CUBEJS_DB_HOST=your-session-pooler-host
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=postgres
# Supabase pooler usernames are <role>.<project-ref>
CUBEJS_DB_USER=cube_reader.your-project-ref
CUBEJS_DB_PASS=change-me
CUBEJS_DB_SSL=true
# Local learning only. In production, provide the provider's CA certificate instead.
CUBEJS_DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Cube ----
CUBEJS_DEV_MODE=true
# generate with: openssl rand -hex 32
CUBEJS_API_SECRET=change-me
CUBEJS_SCHEMA_PATH=model

# ---- Cube SQL API (Postgres wire protocol, optional) ----
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_USER=cube
CUBEJS_SQL_PASSWORD=change-me
